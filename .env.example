NODE_ENV=development
HOST=127.0.0.1
PORT=3100
LOG_LEVEL=info
DATABASE_URL=postgresql://qigong:qigong@127.0.0.1:5432/qigong_platform
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000
# Authgear administrator OIDC client (separate from the future learner membership provider)
ADMIN_OIDC_ISSUER_URL=https://your-authgear-app.authgear.cloud
ADMIN_OIDC_CLIENT_ID=your-admin-oidc-client-id
ADMIN_OIDC_CLIENT_SECRET=replace-with-a-secret-of-at-least-16-characters
ADMIN_OIDC_REDIRECT_URI=https://checkin.example.com/admin/auth/callback
ADMIN_OIDC_POST_LOGOUT_REDIRECT_URI=https://checkin.example.com/admin/
ADMIN_OIDC_SCOPES=openid profile email
