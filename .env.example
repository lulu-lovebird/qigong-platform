NODE_ENV=development
HOST=127.0.0.1
PORT=3100
LOG_LEVEL=info
DATABASE_URL=postgresql://qigong:qigong@127.0.0.1:5432/qigong_platform
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000
OIDC_ISSUER_URL=https://members.example.com
OIDC_CLIENT_ID=qigong-platform
OIDC_CLIENT_SECRET=replace-with-a-secret-of-at-least-16-characters
OIDC_REDIRECT_URI=https://checkin.example.com/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://checkin.example.com/
OIDC_SCOPES=openid profile email
