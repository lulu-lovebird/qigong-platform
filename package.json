{
  "name": "@lulu-lovebird/qigong-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Unified global platform for qigong check-ins across LINE, Telegram, and WhatsApp.",
  "author": "Bean, Bird & Badminton Tech Consulting",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @qigong/public-api dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"apps/**/*.ts\" \"packages/**/*.ts\"",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
